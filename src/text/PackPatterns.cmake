# Packs the pinned hyphenation patterns into HyphenationData.cpp for Hyphenation.cpp: one
# raw-deflate stream per pattern set, from CMake's gzip without its header and trailer.
#   cmake -DHYPH_UTF8=<dir> -DOPENTAAL=<dir> -DOUT=<file> -P PackPatterns.cmake
# Each set is its patterns followed by its exceptions (the lines without digits).

set(_ids en-us en-gb nl de fr es it pt da sv nb fi)
set(_en-us "${HYPH_UTF8}/hyph-en-us.pat.txt" "${HYPH_UTF8}/hyph-en-us.hyp.txt")
set(_en-gb "${HYPH_UTF8}/hyph-en-gb.pat.txt" "${HYPH_UTF8}/hyph-en-gb.hyp.txt")
set(_nl "${OPENTAAL}/hyph_nl_NL.dic")  # ISO 8859-1
set(_de "${HYPH_UTF8}/hyph-de-1996.pat.txt")
set(_fr "${HYPH_UTF8}/hyph-fr.pat.txt")
set(_es "${HYPH_UTF8}/hyph-es.pat.txt")
set(_it "${HYPH_UTF8}/hyph-it.pat.txt")
set(_pt "${HYPH_UTF8}/hyph-pt.pat.txt" "${HYPH_UTF8}/hyph-pt.hyp.txt")
set(_da "${HYPH_UTF8}/hyph-da.pat.txt")
set(_sv "${HYPH_UTF8}/hyph-sv.pat.txt")
set(_nb "${HYPH_UTF8}/hyph-nb.pat.txt" "${HYPH_UTF8}/hyph-nb.hyp.txt")  # Bokmål and Nynorsk share these
set(_fi "${HYPH_UTF8}/hyph-fi.pat.txt")

get_filename_component(_work "${OUT}" DIRECTORY)
string(REPEAT "0x..," 32 _row)
set(_arrays "")
set(_table "")
set(_newline "${_work}/patterns-newline.txt")
file(WRITE "${_newline}" "\n")
foreach(id ${_ids})
  # cmake -E cat copies bytes; file(APPEND) would turn line ends into CRLF.
  set(cat "${_work}/patterns-${id}.txt")
  set(parts "")
  foreach(f ${_${id}})
    list(APPEND parts "${f}" "${_newline}")
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${parts} OUTPUT_FILE "${cat}" RESULT_VARIABLE failed)
  if(failed)
    message(FATAL_ERROR "Couldn't read the patterns for ${id}")
  endif()
  file(SIZE "${cat}" raw)
  file(ARCHIVE_CREATE OUTPUT "${cat}.gz" PATHS "${cat}" FORMAT raw COMPRESSION GZip COMPRESSION_LEVEL 9)
  file(READ "${cat}.gz" hex HEX)
  # gzip: a 10-byte header with no optional fields (flags 0), the deflate stream, an 8-byte trailer.
  string(SUBSTRING "${hex}" 6 2 flags)
  if(NOT flags STREQUAL "00")
    message(FATAL_ERROR "Unexpected gzip header from CMake for ${id}")
  endif()
  string(LENGTH "${hex}" len)
  math(EXPR len "${len} - 20 - 16")
  string(SUBSTRING "${hex}" 20 ${len} hex)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(${_row})" "\\1\n" hex "${hex}")
  string(MAKE_C_IDENTIFIER "k_${id}" var)
  string(APPEND _arrays "const unsigned char ${var}[] = {\n${hex}\n};\n")
  string(APPEND _table "    {\"${id}\", ${var}, sizeof ${var}, ${raw}},\n")
  file(REMOVE "${cat}" "${cat}.gz")
endforeach()

file(WRITE "${OUT}.tmp" "// Generated by src/text/PackPatterns.cmake from the pinned hyphenation patterns.
#include \"text/HyphenationData.h\"

namespace fw::text::detail {
namespace {
${_arrays}}  // namespace

extern const PatternBlob kPatternBlobs[] = {
${_table}};
extern const size_t kPatternBlobCount = sizeof(kPatternBlobs) / sizeof(kPatternBlobs[0]);

}  // namespace fw::text::detail
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp" "${_newline}")
