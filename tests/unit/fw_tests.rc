// f1-ship: a version resource like the app's, so signed copies of the test program can stand in for a release's
// Featherweight.exe in the updater tests (ProductName "Featherweight", version 9.9.9 > any real version).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 9, 9, 9, 0
 PRODUCTVERSION 9, 9, 9, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Featherweight unit tests"
      VALUE "FileVersion", "9.9.9"
      VALUE "ProductName", "Featherweight"
      VALUE "ProductVersion", "9.9.9"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
