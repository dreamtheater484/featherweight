# S3 fixture ("created as Excel shows it", s3-charts): a clustered column chart of two series, a header row and a first column of text.
# Built through Insert > Chart on the selection; Excel reads back the type and series.
sheet-name "Column"
enter A1 "Quarter"
enter B1 "North"
enter C1 "South"
enter A2 "Q1"
enter B2 "120"
enter C2 "80"
enter A3 "Q2"
enter B3 "150"
enter C3 "110"
enter A4 "Q3"
enter B4 "90"
enter C4 "130"
enter A5 "Q4"
enter B5 "200"
enter C5 "160"
chart A1:C5 column
save
expect chart Column 1 type 51 series 2
expect chart Column 1 series 1 =SERIES(Column!$B$1,Column!$A$2:$A$5,Column!$B$2:$B$5,1)
expect chart Column 1 series 2 =SERIES(Column!$C$1,Column!$A$2:$A$5,Column!$C$2:$C$5,2)
